---
import Layout from "@/layouts/main.astro";
import { VideoDownload } from "@/components/VideoDownload";
import { NavbarWithModal } from "@/components/NavbarWithModal";
---

<Layout content={{ title: "Download Video" }}>
  <main class="min-h-screen bg-background">
    <div class="container mx-auto px-4 py-8">
      <NavbarWithModal client:load currentStep={4} totalSteps={4} />

      <div class="max-w-7xl mx-auto mt-8">
        <VideoDownload
          client:load
        />
      </div>
    </div>

    <footer class="bg-muted/50 border-t">
      <div class="container mx-auto px-4 py-6">
        <div class="text-center text-muted-foreground">
          <p>&copy; 2025 Video Generator. All rights reserved.</p>
        </div>
      </div>
    </footer>
  </main>
</Layout>
