---
import { NavbarWithModal } from "@/components/NavbarWithModal.tsx"
import { VideoGallery } from "@/components/VideoGallery"
import "../styles/global.css"
---

<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		<meta name="theme-color" content="#0f172a" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>InstantVideoApp</title>
		<meta name="description" content="Create professional AI videos instantly" />
	</head>

	<body class="min-h-screen bg-slate-950 antialiased relative overflow-x-hidden overscroll-none">
		<!-- Native App Container -->
		<div class="fixed inset-0 flex flex-col bg-slate-950">
			<!-- Status Bar Spacer (for iOS notch) -->
			<div class="safe-area-top bg-slate-950"></div>

			<!-- Top Navigation Bar (Native Style) -->
			<div class="relative z-50 flex-shrink-0">
				<NavbarWithModal client:load currentStep={1} totalSteps={4} />
			</div>

			<!-- Main Scrollable Content -->
			<main class="flex-1 relative overflow-y-auto overscroll-contain">
				<!-- Subtle Background Pattern -->
				<div class="fixed inset-0 pointer-events-none opacity-30">
					<div class="absolute inset-0" style="background-image: radial-gradient(circle at 2px 2px, rgba(139, 92, 246, 0.15) 1px, transparent 0); background-size: 40px 40px;"></div>
				</div>

				<!-- Video Gallery Section -->
				<section class="relative pb-20">
					<VideoGallery client:load />
				</section>
			</main>

			<!-- Bottom Safe Area (for iOS home indicator) -->
			<div class="safe-area-bottom bg-slate-950"></div>
		</div>

		<!-- Home Tour Guide -->
		<!-- <HomeTourGuide client:only="react" /> -->

		<!-- Native App Styles -->
		<style>
			/* iOS Safe Area Support */
			.safe-area-top {
				height: env(safe-area-inset-top);
			}
			.safe-area-bottom {
				height: env(safe-area-inset-bottom);
			}

			/* Disable overscroll bounce effect */
			body {
				overscroll-behavior: none;
				-webkit-overflow-scrolling: touch;
			}

			/* Hide scrollbar for cleaner native look */
			main::-webkit-scrollbar {
				display: none;
			}
			main {
				-ms-overflow-style: none;
				scrollbar-width: none;
			}

			/* Prevent text selection for native feel */
			* {
				-webkit-tap-highlight-color: transparent;
				-webkit-touch-callout: none;
			}

			/* Allow text selection only in specific areas */
			p, span, div[contenteditable] {
				-webkit-user-select: text;
				user-select: text;
			}

			/* Smooth momentum scrolling */
			main {
				-webkit-overflow-scrolling: touch;
			}
		</style>
	</body>
</html>
